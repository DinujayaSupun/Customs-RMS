# Excluded from the frontend Docker build.
# node_modules is reinstalled fresh inside the container via `npm ci`.
node_modules/
dist/
.git/
playwright-report/
test-results/
*.log
.vscode/
.idea/
# Keep local Vite env files out of the image so they can't override the
# VITE_API_BASE_URL build arg baked in by docker-compose.
.env
.env.*
