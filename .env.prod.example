# Copy to .env.prod and fill in REAL values. NEVER commit .env.prod (it holds secrets).
#   cp .env.prod.example .env.prod   &&   edit .env.prod
# Then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- Database ---
DB_NAME=customs_rms
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_USERNAME=rms_app
DB_PASSWORD=CHANGE_ME_strong_app_password

# Where bind-mounted data lives ON THE SERVER. On Linux prefer absolute paths, e.g.:
#   DB_DATA_DIR=/var/lib/customs-rms/mysql
#   UPLOADS_DIR=/var/lib/customs-rms/uploads
# Back up UPLOADS_DIR together with a mysqldump of the database, on the same schedule.
DB_DATA_DIR=./prod-data/mysql
UPLOADS_DIR=./prod-data/uploads

# --- Security ---
# Generate a fresh one:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_base64_256bit_secret
# Session token lifetime in ms (default 8h).
JWT_EXPIRATION_MS=28800000

# --- Public URLs ---
# The public HTTPS origin users hit. Baked into the frontend at build time; the app appends
# /api and derives wss://…/ws. No trailing slash.
PUBLIC_BASE_URL=https://rms.customs.gov.lk
# Allowed browser origin(s) for REST + WebSocket. Usually the same as PUBLIC_BASE_URL.
APP_CORS_ALLOWED_ORIGINS=https://rms.customs.gov.lk

# Host port the frontend container listens on (your TLS reverse proxy forwards to this).
FRONTEND_PORT=3000
