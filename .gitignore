# Root workspace ignores

# OS
.DS_Store
Thumbs.db

# Logs (including rotated/compressed variants, e.g. rms-backend.log.2026-06-26.0.gz)
*.log
*.log.*

# Root-level local envs
.env
.env.*
!.env.example
!.env.prod.example

# Production bind-mount data (database + uploads) — never commit
prod-data/

# Local Spring overrides (secrets stay local)
rms-backend/src/main/resources/application-local.properties
rms-backend/src/main/resources/application-*.local.properties

# VS Code workspace files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Node
node_modules/
**/node_modules/
.m2/

# Build output
dist/

# Generated distributable bundles (zips + saved image tars)
bundles/
images.tar

# IDE
.idea/

# Coverage
coverage/
