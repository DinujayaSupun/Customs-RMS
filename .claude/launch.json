{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "rms-frontend", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "rms-frontend", "run", "dev", "--", "--port", "4000", "--strictPort"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "docker-frontend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "frontend"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
