# Copy this file to .env for local development.
# Keep .env private; it is ignored by Git.

DB_USERNAME=root
DB_PASSWORD=change_me
JWT_SECRET=PUT_BASE64_SECRET_HERE
APP_UPLOAD_DIR=C:/customs_uploads
DC_AUTO_FORWARD_POLL_MS=60000

# Local/dev seed users only. Do not enable this in production.
SPRING_PROFILES_ACTIVE=dev
APP_SEED_ENABLED=true
APP_SEED_DEFAULT_PASSWORD=change_me_for_local_users
APP_SEED_ADMIN_PASSWORD=change_me_for_local_admin

# Frontend E2E credentials. Use accounts created by local seed or your test DB.
RMS_E2E_ADMIN_USER=admin
RMS_E2E_ADMIN_PASS=change_me_for_local_admin
RMS_E2E_DC_USER=dc
RMS_E2E_DC_PASS=change_me_for_local_users
